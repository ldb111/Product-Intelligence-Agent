# 仅含占位配置。复制到本地 .env 后填写；启动方式见 docs/demo.md。
# 空白必需项会报错，不会自动切换模型；基础地址中不放密钥。

# 默认 / 快速角色：llm/config.py，两种角色共用这四项。
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# 推理角色：独立指定供应商、模型、地址。
# 密钥优先 LLM_REASONING_API_KEY；留空则读取供应商大写名称的 *_API_KEY。
LLM_REASONING_PROVIDER=
LLM_REASONING_MODEL=
LLM_REASONING_BASE_URL=
LLM_REASONING_API_KEY=

# 研究角色：llm/research.py，不回退到默认或推理配置。
# 只读取供应商大写名称的 *_API_KEY，没有 LLM_RESEARCH_API_KEY 配置。
LLM_RESEARCH_PROVIDER=
LLM_RESEARCH_MODEL=
LLM_RESEARCH_BASE_URL=
# 例如研究供应商填 deepseek 时使用此项；其他供应商按实际名称设置。
DEEPSEEK_API_KEY=

# 检索：llm/retrieval_models.py，目前只支持 aliyun_bailian。
EMBEDDING_PROVIDER=aliyun_bailian
EMBEDDING_MODEL=
RERANK_PROVIDER=aliyun_bailian
RERANK_MODEL=
ALIYUN_BAILIAN_API_KEY=
ALIYUN_BAILIAN_BASE_URL=
# 可选：覆盖供应商公共基础地址。
# 检索地址必须使用 HTTPS（加密传输协议）。
# EMBEDDING_BASE_URL=
# RERANK_BASE_URL=
# 未显式指定排序地址时，公共路径须为 /compatible-mode/v1，
# 程序推导为 /compatible-api/v1，再追加 /reranks。
# 显式排序地址不含 /reranks，向量地址不含 /embeddings。
# 仅当 LLM_PROVIDER 同为 aliyun_bailian 时，才允许复用 LLM_API_KEY / LLM_BASE_URL。

# 腾讯网页搜索：source_discovery/search/tencent_wsa.py。
WSA_API_KEY=

# 可选：api/main.py 从进程环境读取服务设置。
# 跨域来源在创建应用时读取；状态目录在首次初始化服务时读取；重置开关在请求检查时读取。
# 使用文档中的 uvicorn --env-file .env，确保创建应用前已加载跨域设置。
# PIA_STATE_DIR=.pia-state
# PIA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PIA_ENABLE_TEST_RESET=false
# 测试重置缺省只允许本机开发页面；开启会允许删除测试数据，不应公开暴露服务。
